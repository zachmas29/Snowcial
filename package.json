{
  "name": "snowcial",
  "description": "The Next.js application for Snowcial (burgundy-binturong)",
  "version": "0.1.0",
  "contributors": [
    "Toby Penner <tpenner@middlebury.edu>",
    "Cam Bitter <cbitter@middlebury.edu>",
    "Casy Adjei <cadjei@middlebury.edu>",
    "Ned Cutler <pkcutler@middlebury.edu>",
    "Zachary Okayli Masaryk <zokaylimasaryk@middlebury.edu>"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "pnpm exec tsc --noEmit --strict",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.0",
    "next": "15.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@aivenio/tsc-output-parser": "^2.1.1",
    "@biomejs/biome": "2.2.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "3.2.4",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.4",
    "next-router-mock": "^1.0.2",
    "supabase": "^2.48.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,css,json,jsx,ts,tsx}": "pnpm exec biome check --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase"
    ]
  }
}
